<div class="container"> <h1><%= @item.title %></h1>

<% if @item.image.attached? %>
<%= image_tag @item.image, class: "detail-image" %>
<% end %>

<div class="details">
<p>
  <strong>Description:</strong>
  <%= @item.description %>
</p>

<p>
  <strong>Category:</strong>
  <%= @item.category %>
</p>

<p>
  <strong>Status:</strong>
  <span class="status-badge <%= @item.status.to_s.downcase %>">
    <%= @item.status %>
  </span>
</p>

<p>
  <strong>Location:</strong>
  <%= @item.location %>
</p>

<p>
  <strong>Date:</strong>
  <%= @item.date_lost_found %>
</p>

<p>
  <strong>Contact Name:</strong>
  <%= @item.contact_name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @item.contact_email %>
</p>

</div>

<% if @item.status == "Found" %>
<%= button_to "Claim Item",
claim_item_path(@item),
method: :post,
class: "btn" %>
<% end %>

<%= link_to "✏️ Edit",
edit_item_path(@item),
class: "btn" %>

<%= link_to "🗑️ Delete",
item_path(@item),
data: {
turbo_method: :delete,
turbo_confirm: "Are you sure you want to delete this item?"
},
class: "btn" %>

<%= link_to "← Back",
items_path,
class: "btn" %>

</div>

