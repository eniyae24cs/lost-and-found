<h1>AdminDashboard#index</h1>
<div class="container">

  <h1>🔐 Admin Dashboard</h1>

  <h2>Lost and Found Management System</h2>

  <div class="dashboard-cards">

    <div class="card">
      <h3>📦 Total Items</h3>
      <p><%= Item.count %></p>
    </div>

    <div class="card">
      <h3>🔍 Lost Items</h3>
      <p><%= Item.where(status: "Lost").count %></p>
    </div>

    <div class="card">
      <h3>✅ Found Items</h3>
      <p><%= Item.where(status: "Found").count %></p>
    </div>

  </div>

  <br>

  <%= link_to "📋 View All Items", items_path, class: "btn" %>

  <%= link_to "➕ Add New Item", new_item_path, class: "btn" %>

  <%= button_to "🚪 Logout", admin_logout_path,
      method: :delete,
      class: "btn" %>

</div>
