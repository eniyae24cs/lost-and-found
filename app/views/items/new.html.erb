<div class="container">

  <h1>Report Lost / Found Item</h1>

  <%= form_with model: @item, local: true do |form| %>

    <% if @item.errors.any? %>
      <div class="error">
        <h3>Please correct the following:</h3>

        <ul>
          <% @item.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :title, "Item Name" %>
      <%= form.text_field :title %>
    </div>

    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description %>
    </div>

    <div class="form-group">
      <%= form.label :category %>
      <%= form.select :category,
          ["Mobile", "Laptop", "Bag", "ID Card", "Wallet", "Keys", "Documents", "Other"] %>
    </div>

    <div class="form-group">
      <%= form.label :location, "Lost / Found Location" %>
      <%= form.text_field :location %>
    </div>

    <div class="form-group">
      <%= form.label :date_lost_found, "Date" %>
      <%= form.date_field :date_lost_found %>
    </div>

    <div class="form-group">
      <%= form.label :status %>
      <%= form.select :status, ["Lost", "Found"] %>
    </div>

    <div class="form-group">
      <%= form.label :contact_name, "Contact Name" %>
      <%= form.text_field :contact_name %>
    </div>

    <div class="form-group">
      <%= form.label :contact_email, "Contact Email" %>
      <%= form.email_field :contact_email %>
    </div>

    <div class="form-group">
      <%= form.label :image, "Upload Item Image" %>
      <%= form.file_field :image %>
    </div>

    <%= form.submit "Submit Report", class: "btn" %>

  <% end %>

</div>s

  
